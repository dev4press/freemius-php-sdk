{
  "name": "dev4press/freemius-php-sdk",
  "description": "Freemius PHP SDK",
  "version": "2.0.0",
  "keywords": [
    "freemius",
    "sdk",
    "php"
  ],
  "homepage": "https://freemius.com",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^6.0",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Freemius\\SDK\\": "freemius/",
      "Freemius\\SDK\\Exception\\": "freemius/Exceptions/"
    }
  }
}
